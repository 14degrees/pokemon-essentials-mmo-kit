# The dedicated server and shared protocol run on Linux (Docker/WSL). Keep their
# sources LF regardless of the checkout platform, so shell scripts and configs are
# never CRLF-mangled. (The mkxp-z game tree keeps git's default handling.)
/server/**   text eol=lf
/protocol/** text eol=lf
# Shell scripts anywhere (tools/autopilot/ap.sh runs under Git Bash): a CRLF
# checkout breaks them.
*.sh         text eol=lf
# Battle-record fixtures are raw record bodies: never text, never converted.
/server/test/fixtures/**/*.bin binary
